# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/

# macOS and local IDE metadata
.DS_Store
.idea/
*.iml
.classpath
.project

# Machine-specific Android configuration and generated plugin registration
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# CocoaPods and Flutter-generated iOS files (keep vendored SDKs and lockfiles)
**/ios/Pods/
**/ios/.symlinks/
**/ios/**/xcuserdata/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*

# Android Gradle cache and build outputs
.gradle/
.kotlin/
android/build/
android/app/build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map
/.idea/libraries/Dart_Packages.xml
/.idea/vcs.xml
/.idea/modules.xml
/.idea/misc.xml
/.idea/Mapp-Flutter-Plugin.iml
/.idea/libraries/Flutter_Plugins.xml
/.idea/libraries/Dart_SDK.xml
/.idea/.gitignore
/android/.idea/.name
/android/.idea/gradle.xml
/android/.idea/misc.xml
.idea/libraries/
/android/property**
example/android/app/property*
.settings/
